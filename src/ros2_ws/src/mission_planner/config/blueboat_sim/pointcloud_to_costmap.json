{
  "input_topic": "/rslidar_points",
  "output_topic": "/molo/local/costmap",
  "target_frame": "blueboat/blueboat/base_link",
  "sensor_type": "lidar",
  "lidar_unknown_radius_m": 2.0,

  "visualization_frame": "map",
  "visualization_topic": "/molo/local/costmap_map",

  "use_sensor_data_qos": true,
  "subscription_qos": {
    "depth": 10,
    "reliability": "best_effort"
  },
  "publisher_qos": {
    "depth": 1,
    "reliability": "reliable"
  },
  "resolution": 0.25,
  "width_cells": 240,
  "height_cells": 240,
  "grid_center_xy": [0.0, 0.0],
  "origin_yaw": 0.0,
  "tf_lookup_timeout_s": 1.0,
  "cache_static_tf": true,

  "obstacle_z_min": 0.45,
  "obstacle_z_max": 2.5,
  "min_range_m": 0.8,
  "max_range_m": 55.0,

  "occupied_value": 100,
  "unknown_value": -1,
  "free_value": 0,
  "skip_occupied_within_radius_m": 2.0,
  "skip_occupied_origin_xy": [0.0, 0.0],
  "save_png_dir": "",
  "save_png_every_n_messages": 0
}
