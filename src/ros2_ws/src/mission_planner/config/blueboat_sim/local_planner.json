{
  "input_topic": "/molo/local/costmap",
  "output_topic": "/molo_mpc/reference_path",

  "planner": "rrt_star_rs",
  "planner_params": {
    "config_file": "rrt_star_rs.blueboat_sim.json"
  },

  "output_frame": "map",
  "visualization_frame": "map",
  "visualization_path_topic": "/molo/local_plan/path_map",
  "anchor_start_to_boat": true,
  "tf_lookup_timeout_s": 0.5,

  "start": {
    "mode": "frame_origin",
    "xy": [0.0, 0.0]
  },
  "goal": {
    "mode": "map_xy_latch_offset",
    "map_frame": "map",
    "offset_xy": [25.0, 0.0]
  },

  "free_value": 0,
  "occupied_value": 100,
  "unknown_value": -1,
  "plan_every_n_messages": 1,

  "save_snapshots_dir": "",
  "save_snapshots_every_n_messages": 0,
  "save_snapshots_footprint_every_n": 1,

  "debug": {
    "enabled": false,
    "namespace": "/molo/local_plan/debug",
    "footprint_every_n": 5
  },

  "subscription_qos": {
    "depth": 1,
    "reliability": "best_effort"
  },
  "publisher_qos": {
    "depth": 1,
    "reliability": "reliable"
  }
}
