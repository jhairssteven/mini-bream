<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- T200 thruster macro aligned with ArduPilot SITL blueboat joint layout. -->
  <xacro:macro name="blueboat_engine" params="prefix position:='0 0 0' orientation:='0 0 0' prop_mesh">
    <link name="${namespace}/${prefix}_engine_link">
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>

    <link name="${namespace}/${prefix}_propeller_link">
      <visual>
        <geometry>
          <mesh filename="${prop_mesh}"/>
        </geometry>
        <material name="${prefix}_prop_dark">
          <color rgba="0.01 0.01 0.01 1.0"/>
        </material>
      </visual>
      <collision name="${prefix}_prop_collision">
        <geometry>
          <mesh filename="${prop_mesh}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
      </inertial>
    </link>

    <!-- Fixed azimuth (BlueBoat has no steering pod). -->
    <joint name="${namespace}/${prefix}_chassis_engine_joint" type="revolute">
      <axis xyz="0 0 1"/>
      <limit lower="0" upper="0" effort="0" velocity="0"/>
      <origin xyz="${position}" rpy="${orientation}"/>
      <parent link="${namespace}/base_link"/>
      <child link="${namespace}/${prefix}_engine_link"/>
    </joint>

    <joint name="${namespace}/${prefix}_engine_propeller_joint" type="continuous">
      <axis xyz="0 0 -1"/>
      <parent link="${namespace}/${prefix}_engine_link"/>
      <child link="${namespace}/${prefix}_propeller_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <limit effort="50" velocity="50"/>
      <dynamics friction="0.0" damping="0.02"/>
    </joint>
  </xacro:macro>
</robot>
