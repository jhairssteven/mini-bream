<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="lidar_obstacle_course">
    <physics name="4ms" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-buoyancy-system"
            name="ignition::gazebo::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1025</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <enable>blueboat</enable>
    </plugin>

    <scene>
      <ambient>0.8 0.85 0.9 1</ambient>
      <background>0.5 0.65 0.85 1</background>
      <grid>false</grid>
    </scene>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>40.448417</latitude_deg>
      <longitude_deg>-86.867750</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <include>
      <name>Coast Waves</name>
      <pose>0 0 0 0 0 0</pose>
      <uri>coast_waves</uri>
    </include>

    <!-- 16 lidar test obstacles (primitives only, no VRX model deps) -->

    <model name="lidar_pylon_red">
      <static>true</static>
      <pose>18 8 2.5 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 1.0 5.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 5.0</size></box></geometry>
          <material><ambient>0.85 0.15 0.15 1</ambient><diffuse>0.85 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="lidar_cylinder_blue">
      <static>true</static>
      <pose>-15 12 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.6</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.6</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.1 0.3 0.85 1</ambient><diffuse>0.1 0.3 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="lidar_sphere_green">
      <static>true</static>
      <pose>10 -18 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>1.2</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry><sphere><radius>1.2</radius></sphere></geometry>
          <material><ambient>0.15 0.75 0.2 1</ambient><diffuse>0.15 0.75 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="lidar_wall_segment">
      <static>true</static>
      <pose>35 -5 1.25 0 0 0.5</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.0 0.4 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10.0 0.4 2.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="lidar_ramp_block">
      <static>true</static>
      <pose>-25 -10 0.5 0 0.2 0.8</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.0 1.5 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3.0 1.5 1.0</size></box></geometry>
          <material><ambient>0.7 0.5 0.2 1</ambient><diffuse>0.7 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="lidar_low_platform">
      <static>true</static>
      <pose>50 20 0.4 0 0 -0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.0 4.0 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4.0 4.0 0.8</size></box></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="dock_block_north">
      <static>true</static>
      <pose>28 25 0.25 0 0 0.6</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.0 4.0 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4.0 4.0 0.5</size></box></geometry>
          <material><ambient>0.6 0.55 0.45 1</ambient><diffuse>0.6 0.55 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="dock_block_north_leg">
      <static>true</static>
      <pose>30 27 0.25 0 0 1.57</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.0 4.0 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4.0 4.0 0.5</size></box></geometry>
          <material><ambient>0.6 0.55 0.45 1</ambient><diffuse>0.6 0.55 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="dock_para_west">
      <static>true</static>
      <pose>-40 15 0.5 0 0 1.57</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.0 3.0 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8.0 3.0 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="placard_east">
      <static>true</static>
      <pose>45 -30 1.0 0 0 -0.8</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 2.0 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 2.0 1.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.2 1</ambient><diffuse>0.9 0.9 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="roboboat_obstacle">
      <static>true</static>
      <pose>22 -35 0.15 0 0 2.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.5 0.3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.5 0.3</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="post_mooring_a">
      <static>true</static>
      <pose>-35 -25 1.0 0 0 0.2</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.12</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.12</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="post_mooring_b">
      <static>true</static>
      <pose>55 10 1.0 0 0 -0.5</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.12</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.12</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="robotx_light_buoy">
      <static>true</static>
      <pose>-50 -5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.9 0.2 0.2 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="mb_marker_buoy_red">
      <static>true</static>
      <pose>-20 30 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.325</radius><length>1.1</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.325</radius><length>1.1</length></cylinder></geometry>
          <material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="mb_round_buoy_orange">
      <static>true</static>
      <pose>40 35 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.35</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry><sphere><radius>0.35</radius></sphere></geometry>
          <material><ambient>0.9 0.45 0.05 1</ambient><diffuse>0.9 0.45 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
