# Jetson / dev autonomy image: MPC, ILOS, H0 experiments (no perception, no Gazebo).
# All Python deps baked at build time for offline field operation.
FROM ros:humble-ros-base

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

COPY docker/install_mpc_deps.sh /tmp/install_mpc_deps.sh
COPY docker/install_ros2_ws_deps.sh /tmp/install_ros2_ws_deps.sh
COPY docker/install_autonomy_deps.sh /tmp/install_autonomy_deps.sh
RUN chmod +x /tmp/install_mpc_deps.sh /tmp/install_ros2_ws_deps.sh /tmp/install_autonomy_deps.sh \
    && /tmp/install_ros2_ws_deps.sh \
    && /tmp/install_autonomy_deps.sh

RUN apt-get update && apt-get install -y --no-install-recommends iproute2 nano tmux \
    && rm -rf /var/lib/apt/lists/*

RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc && \
    echo "source /workspace/ros2_ws/install/setup.bash 2>/dev/null || true" >> ~/.bashrc

COPY docker/start_autonomy.sh /start_autonomy.sh
COPY docker/start_h0_boat.sh /workspace/docker/start_h0_boat.sh
COPY docker/start_ilos_boat.sh /workspace/docker/start_ilos_boat.sh
RUN chmod +x /start_autonomy.sh /workspace/docker/start_h0_boat.sh /workspace/docker/start_ilos_boat.sh

ENV DEBIAN_FRONTEND=dialog
WORKDIR /workspace/ros2_ws
CMD ["bash", "/start_autonomy.sh"]
