<?xml version="1.0" encoding="UTF-8" ?>
<!-- Ground station fallback (start_ground_station.sh generates runtime config).
     Override via GROUND_IFACE or GROUND_DDS_ADDRESS. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain>
    <General>
      <Interfaces>
        <NetworkInterface address="192.168.0.104" multicast="true"/>
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
      <Peers>
        <!-- Unicast to every robot-LAN host -->
        <Peer address="192.168.0.100"/> <!-- Pi -->
        <Peer address="192.168.0.101"/>
        <Peer address="192.168.0.102"/> <!-- Jetson -->
        <Peer address="192.168.0.103"/> <!-- ground station -->
        <Peer address="192.168.0.104"/> <!-- c2 -->
        <Peer address="192.168.0.105"/> <!-- c2 ethernet -->
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
