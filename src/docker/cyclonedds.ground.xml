<?xml version="1.0" encoding="UTF-8" ?>
<!-- Ground station fallback (start_ground_station.sh generates runtime config).
     Override via GROUND_IFACE or GROUND_DDS_ADDRESS. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain>
    <General>
      <Interfaces>
        <NetworkInterface address="192.168.0.104" multicast="true"/>
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
      <Peers>
        <Peer address="192.168.0.100"/>
        <Peer address="192.168.0.102"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
