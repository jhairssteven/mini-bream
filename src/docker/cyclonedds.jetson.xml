<?xml version="1.0" encoding="UTF-8" ?>
<!-- Jetson perception: pin DDS to robot LAN address on eth0.
     eth0 also carries LiDAR secondary 192.168.1.102; binding by interface name
     can advertise the wrong subnet and break Pi/GS subscribers. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain>
    <General>
      <Interfaces>
        <NetworkInterface address="192.168.0.102" multicast="true"/>
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
      <Peers>
        <Peer address="192.168.0.100"/>
        <Peer address="192.168.0.103"/> <!-- alienware pc -->
        <Peer address="192.168.0.104"/> <!-- c2 -->
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
