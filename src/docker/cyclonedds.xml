<?xml version="1.0" encoding="UTF-8" ?>
<!-- Cyclone DDS static peers on 192.168.0.0/24 (robot LAN).
     .101 Pi (wlan0)  .102 Jetson  .104 c2
     Only list hosts that answer ARP. A missing peer blocks the shared
     UDP socket for the ARP timeout and stalls every publisher in the process. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain>
    <General>
      <Interfaces>
        <!-- Pi + Jetson: wired LAN on eth0. Ground uses cyclonedds.ground.xml -->
        <NetworkInterface name="eth0" multicast="true"/>
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
      <Peers>
        <Peer address="192.168.0.101"/> <!-- Pi wlan0 -->
        <Peer address="192.168.0.102"/> <!-- Jetson -->
        <Peer address="192.168.0.104"/> <!-- c2 -->
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
