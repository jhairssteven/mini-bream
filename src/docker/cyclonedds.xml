<?xml version="1.0" encoding="UTF-8" ?>
<!-- Cyclone DDS static peers on 192.168.0.0/24 (robot LAN).
     .100 Pi (frontseat)  .101 spare  .102 Jetson (perception)  .103 ground station (RViz) -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain>
    <General>
      <Interfaces>
        <!-- autodetermine: eth0 and WiFi. -->
        <NetworkInterface autodetermine="true" multicast="true"/>
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <Peers>
        <Peer address="192.168.0.100"/>
        <Peer address="192.168.0.101"/>
        <Peer address="192.168.0.102"/>
        <Peer address="192.168.0.103"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
