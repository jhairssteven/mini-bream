<?xml version="1.0" encoding="UTF-8" ?>
<!-- Cyclone DDS static peers on 192.168.0.0/24 (robot LAN).
     .100 Pi (frontseat)  .101 spare  .102 Jetson (perception)  .103 ground station (RViz) -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain>
    <General>
      <Interfaces>
        <!-- Pi + Jetson: wired LAN on eth0. Ground uses cyclonedds.ground.xml -->
        <NetworkInterface name="eth0" multicast="true"/>
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
      <Peers>
        <Peer address="192.168.0.100"/>
        <Peer address="192.168.0.101"/>
        <Peer address="192.168.0.102"/>
        <Peer address="192.168.0.103"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
