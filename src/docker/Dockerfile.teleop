# Robot teleop image: pwm_daemon + radio_rx.
# Builds pigpiod from source (Ubuntu/Debian do not package the daemon).
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /opt/teleop

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-setuptools \
    build-essential \
    wget \
    ca-certificates \
    && wget -q https://github.com/joan2937/pigpio/archive/refs/tags/v79.tar.gz \
    && tar xzf v79.tar.gz \
    && make -C pigpio-79 \
    && make -C pigpio-79 install \
    && ldconfig \
    && rm -rf pigpio-79 v79.tar.gz \
    && pip3 install --no-cache-dir pyserial pigpio \
    && apt-get purge -y build-essential wget \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

COPY teleop/ /opt/teleop/
COPY docker/entrypoint.teleop.sh /entrypoint.teleop.sh
RUN chmod +x /entrypoint.teleop.sh

ENTRYPOINT ["/entrypoint.teleop.sh"]
CMD ["python3", "/opt/teleop/pwm_daemon.py", "--device", "rpi"]
