# mini-bream Docker overrides — copy to .env and uncomment what you need:
#   cp .env.example .env
#
# Dev laptop: uncomment the lines that apply to your setup.
#
# docker compose and mini_bream_env.sh load this file from src/docker/ automatically.

# =============================================================================
# Host time / timezone (all compose stacks)
# =============================================================================

# Containers mount host zoneinfo and use this zone name.
# mini_bream_env.sh sets TZ and LOCALTIME_PATH from the host when unset.
# TZ=America/New_York
# LOCALTIME_PATH=/usr/share/zoneinfo/America/New_York

# =============================================================================
# ROS / DDS (all hosts on the robot LAN must use the same domain)
# =============================================================================

# ROS_DOMAIN_ID=0

# =============================================================================
# Autonomy (docker-compose.autonomy.yml)
# =============================================================================

# Uncomment exactly one:
# AUTONOMY_CYCLONEDDS_URI=file:///etc/cyclonedds.jetson.xml  # Jetson (field): pin 192.168.0.102
# AUTONOMY_CYCLONEDDS_URI=file:///etc/cyclonedds.xml         # laptop on robot LAN
# AUTONOMY_CYCLONEDDS_URI=                                    # local sim: no pin (all interfaces)

# =============================================================================
# Ground station RViz (docker-compose.ground.yml)
# =============================================================================

# DISPLAY=:0
# XDG_RUNTIME_DIR=/tmp/runtime-root

# Wi-Fi NIC on ground PC (also edit cyclonedds.ground.xml if interface name differs)
# GROUND_IFACE=wlp5s0

# Dev: viewing Gazebo / blueboat_sim topics in RViz
# USE_SIM_TIME=1

# RVIZ_CONFIG=/workspace/docker/config/h0_boat.rviz

# =============================================================================
# Pi frontseat (docker-compose.frontseat.yml) — bench / dev on Pi only
# =============================================================================

# Dev: log PWM commands without driving motors
# PWM_BACKEND_OVERRIDE=dry_run

# SiK radio USB path (varies by cable / hub)
# RADIO_SERIAL_PORT=/dev/serial/by-id/usb-FTDI_FT231X_USB_UART_D30GKEF6-if00-port0
# RADIO_BAUD=57600

# Jetson PWM backend instead of Pi (only if running teleop on Jetson)
# DEVICE_CONFIG=jetson

# =============================================================================
# Jetson perception (docker-compose.frontseat.yml → perception service)
# =============================================================================

# LiDAR NIC (factory Airy expects secondary IP on this interface)
# LIDAR_IFACE=eth0

# Dev without LiDAR hardware: skip 192.168.1.102 secondary IP setup
# SETUP_AIRY_NETWORK=0

# =============================================================================
# Simulation (docker-compose.simulation.yml) — dev laptop
# =============================================================================

# DISPLAY=:0

# =============================================================================
# mini_bream_sync.sh — paths and SSH targets for your machines
# =============================================================================

# JETSON_IP=192.168.0.102
# JETSON_SSH_USER=orin-nano
# JETSON_REPO=/home/orin-nano/mini-bream

# GROUND_IP=
# GROUND_SSH_USER=
# GROUND_REPO=

# PI_IP=192.168.0.100
# PI_SSH_USER=pi

# Password auth for sync / sync_field_time (prefer SSH keys).
# SSHPASS_* is used for SSH; sudo on the remote reuses the same password unless
# you set SUDO_PASS_PI / SUDO_PASS_JETSON to a different value.
# SSHPASS_JETSON=
# SSHPASS_GROUND=
# SSHPASS_PI=

# sync_field_time.sh — push ground-station clock to Pi/Jetson (offline field)
# SYNC_TIMEZONE=1        # copy TZ from ground station
# SYNC_HWCLOCK=1         # write RTC on remotes after setting system time

# preflight_host_clock.sh — refuse start pi|jetson|autonomy if host clock < 2024
# SKIP_CLOCK_PREFLIGHT=0
# MIN_EPOCH_SECS=1704067200
