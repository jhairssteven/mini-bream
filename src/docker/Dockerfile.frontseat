# Frontseat image: bare minimum to run the frontseat packages (Pi).
FROM ros:humble-ros-base

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

COPY docker/install_ros2_ws_deps.sh /tmp/install_ros2_ws_deps.sh
RUN chmod +x /tmp/install_ros2_ws_deps.sh && /tmp/install_ros2_ws_deps.sh

# PWM backends for legacy motor driver code paths
RUN pip install --no-cache-dir pigpio Jetson.GPIO

RUN apt-get update && apt-get install -y --no-install-recommends nano tmux \
    && rm -rf /var/lib/apt/lists/*

RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc

ENV DEBIAN_FRONTEND=dialog
WORKDIR /workspace/ros2_ws
CMD ["bash"]
