# Telemetry transmitter: Linux joystick → SiK radio serial (no ROS).
FROM python:3.11-slim-bookworm

WORKDIR /opt/teleop

RUN pip install --no-cache-dir pyserial

COPY teleop/ /opt/teleop/

ENV JOY_DEVICE=/dev/input/js0
ENV RADIO_SERIAL_PORT=/dev/ttyUSB0
ENV RADIO_BAUD=57600

CMD ["python3", "/opt/teleop/joy_to_serial.py"]
